{
  "manifest_version": 3,
  "name": "Plum",
  "short_name": "Plum",
  "version": "0.1.7",
  "description": "A private Solana, Ethereum and Bitcoin wallet in typed ASCII. Keys sealed on this computer; every request simulated before you sign.",
  "browser_specific_settings": {
    "gecko": {
      "id": "plum-wallet@plum.fun",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Plum",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["storage", "alarms", "idle", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://api.mainnet-beta.solana.com/*"],
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https: data:; font-src 'self'; connect-src https: http://localhost:* http://127.0.0.1:*; object-src 'none'; base-uri 'none'; form-action 'none'"
  }
}
